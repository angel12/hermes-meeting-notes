+def _xai_auth(url: str) -> tuple[dict[str, str], str]:
+    """Core-owned resolution; never fall back to API-key billing."""
+    from tools.xai_http import resolve_xai_http_credentials
+
+    creds = resolve_xai_http_credentials()
+    if creds.get("provider") != "xai-oauth" or not creds.get("api_key"):
+        raise ProviderNotSignedIn("Sign in to xAI in the owning Hermes profile; API-key fallback is disabled.")
+    return {"Authorization": "Bearer " + creds["api_key"]}, str(creds.get("base_url") or "")
+
+
+def provider_request_capabilities() -> dict[str, Any]:
+    """Static transport capabilities, not login status or subscription entitlement.
+
+    Does not load auth stores, refresh tokens, or make network requests.
+    """
+    return {"version": 1, "providers": sorted(_PROVIDERS), "multipart": True}
+
+
 # provider -> (origins its token may be sent to, auth resolver). chatgpt.com is the Codex backend
 # core itself calls; api.openai.com hosts the Realtime client-secret endpoint Codex clients use.
 _PROVIDERS: dict[str, tuple[frozenset, Callable[[str], tuple[dict[str, str], str]]]] = {
+    "xai-oauth": (frozenset({("https", "api.x.ai", 443)}), _xai_auth),
